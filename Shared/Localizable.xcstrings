{
  "sourceLanguage": "en",
  "strings": {
    "A Git operation is running on this repository. Try again shortly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个仓库正在执行 Git 操作，请稍后再试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリでGit操作を実行中です。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "Could not find that file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到这个文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのファイルが見つかりません。"
          }
        }
      }
    },
    "Repositories can only be deleted from within Gitling.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库只能在 Gitling 里删除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリはGitling内でのみ削除できます。"
          }
        }
      }
    },
    "That name cannot be used.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能使用这个名字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前は使用できません。"
          }
        }
      }
    },
    "That name is already used.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前はすでに使われています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个名称已经用过了。"
          }
        }
      }
    },
    "Trash": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱"
          }
        }
      }
    },
    "Working Set": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作集"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークセット"
          }
        }
      }
    }
  },
  "version": "1.0"
}
