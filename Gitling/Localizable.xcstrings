{
  "sourceLanguage": "en",
  "strings": {
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "%d repositories": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d個のリポジトリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 个仓库"
          }
        }
      }
    },
    "$ %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "$ %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "$ %@"
          }
        }
      }
    },
    "1 repository": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1個のリポジトリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个仓库"
          }
        }
      }
    },
    "A folder with the repository name is created inside the location you choose. Git data stays in Gitling, so that folder does not get a .git directory.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した場所にリポジトリ名のフォルダが作成されます。GitデータはGitling内に保持されるため、そのフォルダに.gitは作成されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会在你选择的位置下创建以仓库名命名的文件夹。Git 数据留在 Gitling，所以该文件夹里不会出现 .git。"
          }
        }
      }
    },
    "A Git operation is running on this repository. Try again shortly.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリでGit操作を実行中です。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个仓库正在执行 Git 操作，请稍后再试。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
