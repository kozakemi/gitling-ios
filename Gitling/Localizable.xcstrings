        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Stash 已不存在。"
          }
        }
      }
    },
    "The conflict or file changed. Refresh before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冲突或文件已变化，请刷新后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "競合またはファイルが変更されました。更新して再試行してください。"
          }
        }
      }
    },
    "The copied repository is incomplete. Nothing was imported.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたリポジトリが不完全なため、インポートしませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库副本不完整，未完成导入。"
          }
        }
      }
    },
    "The current working file will be staged as the resolution.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将暂存当前工作文件作为解决结果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の作業ファイルを解決結果としてステージします。"
          }
        }
      }
    },
    "The import destination must be outside the source repository.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポート先は元のリポジトリの外に指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入目标必须位于源仓库之外。"
          }
        }
      }
    },
    "The source changed during import. Nothing was imported. Try again when it is idle.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポート中に元のリポジトリが変更されたため、インポートしませんでした。操作が終了してから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源仓库在导入过程中发生变化，未完成导入。请在仓库空闲时重试。"
          }
        }
      }
    },
    "The source has a Git lock. Finish the Git operation before importing.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のリポジトリに Git ロックがあります。Git 操作を完了してからインポートしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源仓库存在 Git 锁，请先完成 Git 操作再导入。"
          }
        }
      }
    },
    "The stash has conflicts. The stash was kept. Resolve the files before staging.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタッシュの復元で競合が発生しました。元のスタッシュは保持されています。ファイルの競合を解決してからステージしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stash 恢复存在冲突，已保留原 Stash。请解决文件冲突后再暂存。"
          }
        }
      }
    },
    "The working file will be deleted and its deletion staged.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除工作文件，并暂存此删除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業ファイルを削除し、その削除をステージします。"
          }
        }
      }
    },
    "Theirs": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传入一方"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込む側"
          }
        }
      }
    },
    "This branch has unmerged commits.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブランチには未マージのコミットがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支包含尚未合入当前分支的提交。"
          }
        }
      }
    },
    "This file is too large for the edit round trip.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件超过外部编辑导入的大小限制（16 MiB）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは外部編集の読み込み上限（16 MiB）を超えています。"
          }
        }
      }
    },
    "This operation has already committed. Continue to finish recovery.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作已生成提交，请选择继续以完成恢复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作はすでにコミット済みです。続行して復旧を完了してください。"
          }
        }
      }
    },
    "This operation was started outside Gitling. Resolve files here, then use the original Git tool to continue or abort.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作由外部工具启动。可在此解决文件冲突，再使用原 Git 工具继续或中止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は外部ツールで開始されました。ここでファイルの競合を解決し、元のGitツールで続行または中止してください。"
          }
        }
      }
    },
    "This permanently removes the saved changes in this stash.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスタッシュに保存された変更を完全に削除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除此 Stash 中保存的修改。"
          }
        }
      }
    },
    "This repository depends on external Git data. Import a self-contained repository instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリは外部の Git データに依存しています。自己完結型の完全なリポジトリを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此仓库依赖外部 Git 数据，请选择包含独立 Git 数据的完整仓库。"
          }
        }
      }
    },
    "This restores the branch and tracked files to the state before the operation. Resolution edits will be discarded. Unrelated untracked files are kept.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将分支和已跟踪文件恢复到操作前。解决冲突时的编辑会被丢弃，无关的未跟踪文件会保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブランチと追跡対象ファイルを操作前に戻します。競合解決の編集は破棄されます。無関係な未追跡ファイルは保持されます。"
          }
        }
      }
    },
    "Unresolved files": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未解决的文件"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未解決のファイル"
          }
        }
      }
    },
    "Unstage": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージ解除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消暂存"
          }
        }
      }
    },
    "Unstaged Changes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未ステージの変更"
          }
        },
        "zh-Hans": {
