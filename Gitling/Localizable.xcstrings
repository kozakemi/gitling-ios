          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改"
          }
        }
      }
    },
    "Changes not staged for commit:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミットされていない変更:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未暂存的更改："
          }
        }
      }
    },
