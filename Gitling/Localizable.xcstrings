        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトークンにはこのGitLabアカウントを読み取る権限がありません。"
          }
        }
      }
    },
    "Couldn't reach GitLab. Check the address and your connection.": {
      "localizations": {
