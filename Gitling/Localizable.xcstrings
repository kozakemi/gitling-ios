    "Checking out a tag enters detached HEAD. Branches and tags will not move. Commit or stash all local changes first, including untracked files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking out a tag enters detached HEAD. Branches and tags will not move. Commit or stash all local changes first, including untracked files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检出标签后会进入分离的 HEAD 状态，分支和标签引用不会移动。请先提交或 Stash 所有本地修改，包括未跟踪文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグをチェックアウトすると HEAD が切り離されます。ブランチとタグの参照は移動しません。未追跡ファイルを含むすべてのローカル変更を先にコミットまたはスタッシュしてください。"
          }
        }
      }
    },
    "Submodules are not automatically updated. New commits will not belong to a branch until you create one.": {
      "localizations": {
