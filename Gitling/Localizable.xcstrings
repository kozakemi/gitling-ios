      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのブランチ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有分支"
          }
        }
      }
    },
    "Approve the sign-in in your browser. Your code is %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでサインインを承認してください。コードは %@ です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中批准登录。你的验证码是 %@。"
          }
        }
      }
    },
