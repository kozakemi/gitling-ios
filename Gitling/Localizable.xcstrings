    "Connect with GitHub": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubと接続"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 GitHub"
          }
        }
