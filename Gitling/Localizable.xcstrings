    "Discard Unstaged Changes?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard Unstaged Changes?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃未暂存的修改？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未ステージの変更を破棄しますか？"
          }
        }
      }
    },
    "Could not update submodules. Completed work and local Git data were kept. Retry after fixing the reported submodule.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not update submodules. Completed work and local Git data were kept. Retry after fixing the reported submodule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新子模块。已保留完成的步骤和本地 Git 数据。请处理出错的子模块后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブモジュールを更新できませんでした。完了した処理とローカル Git データは保持されています。問題を解決して再試行してください。"
          }
        }
      }
    },
    "The parent index, submodule configuration, or working folder changed. End this update and review the new state before starting again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parent index, submodule configuration, or working folder changed. End this update and review the new state before starting again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "父仓库索引、子模块配置或工作目录已变化。请结束本轮更新，检查新状态后重新开始。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "親のインデックス、サブモジュール設定、または作業フォルダが変更されました。この更新を終了し、新しい状態を確認してから再開してください。"
          }
        }
      }
    },
    "A submodule has local changes or an unfinished operation. Commit or stash them before updating. No force checkout is performed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A submodule has local changes or an unfinished operation. Commit or stash them before updating. No force checkout is performed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子模块有本地修改或未完成的操作。请先提交或 Stash 后再更新，不会强制检出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブモジュールにローカル変更または未完了の操作があります。更新前にコミットまたはスタッシュしてください。強制チェックアウトは行いません。"
          }
        }
      }
    },
    "Submodule URLs must not contain passwords. Configure credentials in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submodule URLs must not contain passwords. Configure credentials in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子模块 URL 不得包含密码。请在设置中配置凭据。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブモジュール URL にパスワードは含められません。設定で認証情報を構成してください。"
          }
        }
      }
    },
    "Resume or end the pending submodule update first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume or end the pending submodule update first."
