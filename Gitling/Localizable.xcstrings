      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更あり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有改动"
          }
        }
      }
    },
    "Changes to be committed:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミット予定の変更:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂存待提交的更改："
          }
        }
      }
    },
    "Cherry-pick": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェリーピック"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拣选"
          }
        }
      }
    },
    "Cherry-pick of a merge commit is not in this version.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンではマージコミットのチェリーピックはできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一版不能拣选合并提交。"
          }
        }
      }
    },
    "Choose a branch": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブランチを選択"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择分支"
          }
        }
      }
    },
    "Choose a folder in the Files app when cloning, or turn on the Gitling location.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クローン時に「ファイル」Appでフォルダを選択するか、Gitlingの場所をオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "克隆时可以在「文件」App 中选择文件夹，也可以打开 Gitling 自己的位置。"
          }
        }
      }
    },
    "Choose Folder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを選択"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文件夹"
          }
        }
      }
    },
