          }
        }
      }
    },
    "Initialize saves local configuration without downloading. Update checks out the commits recorded in the parent index, not the latest remote branches.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Initialize saves local configuration without downloading. Update checks out the commits recorded in the parent index, not the latest remote branches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初始化只保存本地配置，不下载内容。更新会检出父仓库索引记录的提交，不追踪远端分支最新提交。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期化はローカル設定の保存のみで、ダウンロードしません。更新は親のインデックスに記録されたコミットをチェックアウトし、リモートブランチの最新版には追従しません。"
          }
        }
      }
    },
    "Completed: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed: %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成：%lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了：%lld"
          }
        }
      }
    },
    "A previous update is unfinished. Retry uses its saved options. Ending keeps completed work, downloaded objects, and backup references; it does not roll back files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous update is unfinished. Retry uses its saved options. Ending keeps completed work, downloaded objects, and backup references; it does not roll back files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次更新尚未完成。重试会沿用已保存的选项。结束任务会保留完成的步骤、已下载对象及备份引用，不回滚文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の更新が未完了です。再試行は保存済みの設定を使用します。終了しても完了した処理、ダウンロード済みオブジェクト、バックアップ参照は保持され、ファイルは巻き戻しません。"
          }
        }
      }
    },
    "Submodule Credentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submodule Credentials"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子模块凭据"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブモジュールの認証情報"
          }
        }
      }
    },
    "Each remote uses its own matching account. For SSH remotes on another host, select a key here. Newly discovered nested remotes use matching saved accounts; retry to choose their SSH keys if needed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each remote uses its own matching account. For SSH remotes on another host, select a key here. Newly discovered nested remotes use matching saved accounts; retry to choose their SSH keys if needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个远端分别匹配账户。其他主机的 SSH 远端请在此选择密钥。新发现的嵌套远端会匹配已保存账户；需要指定其 SSH 密钥时可在失败后选择并重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各リモートに一致するアカウントを使用します。別ホストの SSH リモートにはここで鍵を選択してください。新たに見つかった入れ子のリモートも保存済みアカウントと照合します。SSH 鍵の指定が必要なら、失敗後に選択して再試行できます。"
          }
        }
      }
    },
