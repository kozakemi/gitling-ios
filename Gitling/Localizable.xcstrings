      }
    },
    "GitLab rejected this token. Check that it is valid and has read_api.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitLab 拒绝了这个令牌。请确认令牌有效并有 read_api 权限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitLabがこのトークンを拒否しました。有効でread_api権限があるか確認してください。"
          }
        }
      }
    },
    "This token does not have permission to read this GitLab account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个令牌没有读取该 GitLab 账号的权限。"
