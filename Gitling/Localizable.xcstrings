      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クローン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "克隆"
          }
        }
      }
    },
    "Clone or create a repository in this app.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このAppでリポジトリをクローンするか作成してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "克隆或在本应用里初始化一个仓库。"
          }
        }
      }
    },
    "Cloning…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クローン中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在克隆…"
          }
        }
      }
    },
    "Commands: status, log, diff, branch, help. This console runs those Git commands. It is not a shell.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド: status、log、diff、branch、help。このコンソールはこれらのGitコマンドを実行します。シェルではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令：status、log、diff、branch、help。这里执行这些 Git 命令，不是终端外壳。"
          }
        }
      }
    },
    "Commands: status, log, diff, branch, help. This is not a shell.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド: status、log、diff、branch、help。シェルではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令：status、log、diff、branch、help。这不是终端外壳。"
          }
        }
      }
    },
