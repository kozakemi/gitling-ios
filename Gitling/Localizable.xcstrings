            "state": "translated",
            "value": "未暂存的修改"
          }
        }
      }
    },
    "Upstream": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上流ブランチ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上游分支"
          }
        }
      }
    },
    "Working file": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作文件"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業ファイル"
          }
        }
      }
    },
    "The file, index, or working folder changed. Review the changes and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file, index, or working folder changed. Review the changes and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件、索引或工作目录已变化。请重新查看更改后再试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル、インデックス、または作業フォルダが変更されました。変更を確認してから再試行してください。"
          }
        }
      }
    },
    "Only regular tracked files can be restored. Symbolic links, folders, and submodules are protected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only regular tracked files can be restored. Symbolic links, folders, and submodules are protected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能恢复普通的已跟踪文件。符号链接、文件夹和子模块受到保护。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の追跡対象ファイルのみ復元できます。シンボリックリンク、フォルダ、サブモジュールは保護されています。"
          }
        }
      }
    },
    "This file has no staged version. Untracked files and staged deletions are not restored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file has no staged version. Untracked files and staged deletions are not restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件在索引中没有版本。不会恢复未跟踪文件或已暂存的删除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルにはインデックス内の版がありません。未追跡ファイルやステージ済みの削除は復元しません。"
          }
        }
      }
    },
    "This file uses Git LFS. Restore it with an LFS-aware tool to avoid replacing its contents with a pointer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file uses Git LFS. Restore it with an LFS-aware tool to avoid replacing its contents with a pointer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件使用 Git LFS。请使用支持 LFS 的工具恢复，以免将内容替换为指针文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは Git LFS を使用しています。内容がポインタに置き換わらないよう、LFS 対応ツールで復元してください。"
          }
        }
      }
    },
    "Discard Changes…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard Changes…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃修改…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を破棄…"
          }
        }
      }
    },
    "Source: Index (staged version)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source: Index (staged version)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复来源：索引（已暂存版本）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元元：インデックス（ステージ済みの版）"
          }
        }
      }
    },
    "Recreate this deleted working file from the index. Staged changes will be kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recreate this deleted working file from the index. Staged changes will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从索引重新创建此已删除的工作文件。已暂存的更改将保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除された作業ファイルをインデックスから再作成します。ステージ済みの変更は保持されます。"
          }
        }
      }
    },
    "Replace only this working file with its index version. Its unstaged changes will be lost. Staged changes will be kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace only this working file with its index version. Its unstaged changes will be lost. Staged changes will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用索引版本替换此工作文件。此文件未暂存的修改将丢失，已暂存的更改将保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この作業ファイルのみをインデックスの版で置き換えます。未ステージの変更は失われ、ステージ済みの変更は保持されます。"
          }
        }
      }
    },
    "This changes the file in your linked external working folder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes the file in your linked external working folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会修改已关联的外部工作目录中的文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク済みの外部作業フォルダ内のファイルを変更します。"
          }
        }
      }
    },
    "Other files and the index will not be changed. This action cannot be undone in Gitling.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other files and the index will not be changed. This action cannot be undone in Gitling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他文件及索引不会更改。此操作无法在 Gitling 中撤销。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のファイルとインデックスは変更しません。この操作は Gitling 内で取り消せません。"
          }
        }
      }
    },
    "Restore File": {
      "localizations": {
