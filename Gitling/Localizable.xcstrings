    "Connect with GitHub": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubと接続"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 GitHub"
          }
        }
      }
    },
    "Connect with GitHub in Settings to choose a repository.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でGitHubに接続すると、リポジトリを選択できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置里连接 GitHub 后，就可以选择该账号下的仓库。"
          }
        }
      }
    },
    "Connected as %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ として接続中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接为 %@"
          }
        }
      }
    },
    "Connected, but couldn't load your GitHub profile.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続しましたが、GitHubプロフィールを読み込めませんでした。"
