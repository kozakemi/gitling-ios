            "state": "translated",
            "value": "HTTP、HTTPS、SSHのリポジトリのみ対応しています。"
          }
        }
      }
    },
    "HTTP sends tokens in clear text. Use it only on a trusted network.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 会明文传输令牌，只应在可信网络中使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPではトークンが平文で送信されます。信頼できるネットワークでのみ使用してください。"
          }
        }
      }
