          "stringUnit": {
            "state": "translated",
            "value": "サブモジュールを更新しますか？"
          }
        }
      }
    },
    "Initialize Submodules?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Initialize Submodules?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初始化子模块？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブモジュールを初期化しますか？"
          }
        }
      }
    },
    "Only submodules are changed. Local modifications block checkout. Updates may download missing commits; successful steps are retained if a later step fails. Linked external working folders are changed in place.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only submodules are changed. Local modifications block checkout. Updates may download missing commits; successful steps are retained if a later step fails. Linked external working folders are changed in place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅修改子模块。本地修改会阻止检出。更新可能下载缺失的提交，后续失败时会保留已完成的步骤。关联的外部工作区会就地更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブモジュールのみを変更します。ローカル変更がある場合はチェックアウトを中止します。必要なコミットをダウンロードする場合があり、後続処理が失敗しても完了済みの処理は保持されます。リンク先の外部作業フォルダはその場で更新します。"
          }
        }
      }
    },
    "End This Update?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End This Update?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束本轮更新？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この更新を終了しますか？"
          }
        }
      }
    },
    "Keep completed work and local Git data, and remove only the saved task. No files are rolled back or deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep completed work and local Git data, and remove only the saved task. No files are rolled back or deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留已完成的工作和本地 Git 数据，仅清除保存的任务记录。不回滚或删除文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了した処理とローカル Git データを保持し、保存されたタスクのみを削除します。ファイルの巻き戻しや削除は行いません。"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "en": {
